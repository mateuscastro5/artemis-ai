# Qdrant (use Qdrant Cloud URL + API key in production)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=pr_complexity_examples

# OpenRouter LLM
OPENROUTER_API_KEY=
LLM_MODEL=minimax/minimax-m2.5:free

# Voyage AI Embeddings (for RAG examples in Qdrant)
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-code-3
EMBEDDING_DIM=1024

# Mem0 Platform (per-developer temporal memory)
MEM0_API_KEY=

# Pipeline Configuration
CONFIDENCE_THRESHOLD=0.7
MAX_DIFF_LINES=3000

# NestJS Callback (set to the public URL of perform-api in production)
NESTJS_CALLBACK_URL=http://localhost:3000

# Internal API Key (must match perform-api's AI_SERVICE_API_KEY)
INTERNAL_API_KEY=
